from PIL import Image, ImageDraw
import math, os

W, H = 600, 450
FPS = 24
DURATION = 6
N = FPS * DURATION

# Five decorative nodes
nodes = [
    (105, 95),
    (300, 65),
    (500, 135),
    (430, 355),
    (165, 330),
]

# A visually pleasing path through the network
route = [0, 1, 2, 3, 4, 1, 0]

# Connections in the background
edges = [
    (0,1), (1,2), (2,3), (3,4), (4,0), (1,3), (0,2)
]

def ease(t):
    return 3*t*t - 2*t*t*t

def lerp(a, b, t):
    return a + (b-a)*t

frames = []

# Each route segment gets equal time
segments = len(route) - 1
frames_per_seg = N / segments

for frame_idx in range(N):
    img = Image.new("RGBA", (W, H), (255, 255, 255, 255))
    d = ImageDraw.Draw(img, "RGBA")
    
    # Background connection lines
    for a, b in edges:
        x1, y1 = nodes[a]
        x2, y2 = nodes[b]
        d.line((x1, y1, x2, y2), fill=(205, 210, 216, 150), width=2)
    
    # Determine active segment
    seg_float = frame_idx / frames_per_seg
    seg = min(int(seg_float), segments - 1)
    local_t = seg_float - seg
    t = ease(local_t)
    
    a_idx, b_idx = route[seg], route[seg+1]
    x1, y1 = nodes[a_idx]
    x2, y2 = nodes[b_idx]
    x = lerp(x1, x2, t)
    y = lerp(y1, y2, t)
    
    # Nodes, with a gentle reaction at destination
    for i, (nx, ny) in enumerate(nodes):
        pulse = 0
        if i == b_idx:
            pulse = max(0, 1 - abs(local_t - 0.93) / 0.18)
        outer_r = 8 + 7 * pulse
        if pulse > 0:
            d.ellipse((nx-outer_r, ny-outer_r, nx+outer_r, ny+outer_r),
                      outline=(110, 120, 135, int(90*pulse)), width=2)
        d.ellipse((nx-6, ny-6, nx+6, ny+6),
                  fill=(255,255,255,255),
                  outline=(120,125,132,255), width=2)
    
    # Fading trail behind the moving agent
    for k in range(1, 8):
        tt = max(0, local_t - 0.035*k)
        et = ease(tt)
        tx = lerp(x1, x2, et)
        ty = lerp(y1, y2, et)
        alpha = max(0, 110 - k*13)
        r = max(1, 4 - k*0.35)
        d.ellipse((tx-r, ty-r, tx+r, ty+r), fill=(45, 55, 70, alpha))
    
    # Agent halo pulse
    halo = 17 + 3 * math.sin(frame_idx / FPS * math.pi * 2)
    d.ellipse((x-halo, y-halo, x+halo, y+halo),
              outline=(80, 90, 110, 70), width=2)
    
    # Agent core
    d.ellipse((x-9, y-9, x+9, y+9), fill=(30, 34, 42, 255))
    
    # Small four-point sparkle to make it feel "agentic" without being a robot
    s = 15
    sparkle = [
        (x, y-s),
        (x+4, y-4),
        (x+s, y),
        (x+4, y+4),
        (x, y+s),
        (x-4, y+4),
        (x-s, y),
        (x-4, y-4),
    ]
    d.polygon(sparkle, fill=(255,255,255,240))
    
    frames.append(img.convert("P", palette=Image.ADAPTIVE, colors=256))

out = "/mnt/data/agent.gif"
frames[0].save(
    out,
    save_all=True,
    append_images=frames[1:],
    duration=int(1000/FPS),
    loop=0,
    disposal=2,
    optimize=True
)

print(out)
